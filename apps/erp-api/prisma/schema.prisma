generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless imports work with ts-node, Jest and the Nest build
  importFileExtension = ""
  // Partial unique index: at most one default ship-to per B2B unit
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Table and column names in PostgreSQL use lowercase snake_case,
// so they can be queried in SQL without quotes
model Material {
  materialNumber String   @id @map("material_number")
  description    String
  // DEPRECATED since Sprint 9C-B: list prices are ZP01 condition records per
  // sales area. These columns are kept (nullable) until the Backoffice no
  // longer sends them and are never used for price determination.
  price          Decimal? @db.Decimal(12, 2)
  currency       String?  @db.Char(3)

  // Relation only; the materials table itself has no new columns
  priceConditions PriceCondition[]

  @@map("materials")
}

// General customer data (comparable to SAP KNA1). Sales-area data such as
// currency, partner functions and pricing will live in separate tables
// that reference customer_number.
model Customer {
  customerNumber String  @id @map("customer_number") @db.VarChar(20)
  name           String  @db.VarChar(100)
  street         String  @db.VarChar(100)
  postalCode     String  @map("postal_code") @db.VarChar(10)
  city           String  @db.VarChar(60)
  country        String  @db.Char(2)
  isActive       Boolean @default(true) @map("is_active")

  // Relation only; the customers table itself has no new columns
  accountMembership CustomerAccountMember?
  priceConditions   PriceCondition[]
  salesAreas        CustomerSalesArea[]

  @@map("customers")
}

// ISO 4217 currency with its number of decimal places (comparable to SAP
// TCURC and TCURX), e.g. EUR 2, JPY 0. Configuration: created by migrations,
// read-only in the API. Amounts are stored with their real value (700000 JPY
// is stored as 700000), not shifted like SAP stores JPY amounts.
// CHECK constraints in the migration: code is three capital letters,
// decimals between 0 and 3, name not blank.
model Currency {
  code     String  @id @db.Char(3)
  name     String  @db.VarChar(60)
  decimals Int     @db.SmallInt
  isActive Boolean @default(true) @map("is_active")

  salesOrganizations SalesOrganization[]

  @@map("currencies")
}

// Organizational structure of sales (comparable to SAP TVKO, TVTW, TSPA and
// TVTA). Configuration created by migrations, read-only in the API. Codes
// are text, not numbers: "00" is a valid division. CHECK constraints in the
// migration check the code formats and that names are not blank.

// A sales organization sells in one market with one currency (simplified:
// SAP derives the currency from the company code and the customer master)
model SalesOrganization {
  code         String  @id @db.Char(4)
  name         String  @db.VarChar(60)
  country      String  @db.Char(2)
  currencyCode String  @map("currency_code") @db.Char(3)
  isActive     Boolean @default(true) @map("is_active")

  currency   Currency    @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  salesAreas SalesArea[]
  // Price conditions must use the currency of their sales organization
  priceConditions PriceCondition[]

  // Target of the foreign key that checks the currency of price conditions
  @@unique([code, currencyCode], map: "sales_organizations_code_currency_key")
  @@index([currencyCode])
  @@map("sales_organizations")
}

model DistributionChannel {
  code String @id @db.Char(2)
  name String @db.VarChar(60)

  salesAreas SalesArea[]

  @@map("distribution_channels")
}

model Division {
  code String @id @db.Char(2)
  name String @db.VarChar(60)

  salesAreas SalesArea[]

  @@map("divisions")
}

// A valid combination of sales organization, distribution channel and
// division, e.g. 1000/10/00. Only listed combinations can be used.
model SalesArea {
  salesOrganization   String  @map("sales_organization") @db.Char(4)
  distributionChannel String  @map("distribution_channel") @db.Char(2)
  division            String  @db.Char(2)
  isActive            Boolean @default(true) @map("is_active")

  organization   SalesOrganization   @relation(fields: [salesOrganization], references: [code], onDelete: Restrict, onUpdate: Restrict)
  channel        DistributionChannel @relation(fields: [distributionChannel], references: [code], onDelete: Restrict, onUpdate: Restrict)
  divisionRecord Division            @relation(fields: [division], references: [code], onDelete: Restrict, onUpdate: Restrict)

  customerAssignments CustomerSalesArea[]
  b2bUnits            B2bUnit[]
  priceConditions     PriceCondition[]

  @@id([salesOrganization, distributionChannel, division])
  @@index([distributionChannel])
  @@index([division])
  @@map("sales_areas")
}

// Assignment of a customer to a sales area (comparable to SAP KNVV, the
// sales area data of the customer master). A customer can be assigned to
// several sales areas and can only be a partner of B2B units in those.
// Assignments are never deleted; they are deactivated via isActive.
model CustomerSalesArea {
  customerNumber      String  @map("customer_number") @db.VarChar(20)
  salesOrganization   String  @map("sales_organization") @db.Char(4)
  distributionChannel String  @map("distribution_channel") @db.Char(2)
  division            String  @db.Char(2)
  isActive            Boolean @default(true) @map("is_active")

  customer  Customer  @relation(fields: [customerNumber], references: [customerNumber], onDelete: Restrict, onUpdate: Restrict)
  salesArea SalesArea @relation(fields: [salesOrganization, distributionChannel, division], references: [salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict)

  soldToUnits       B2bUnit[]       @relation("UnitSoldToSalesArea")
  billToUnits       B2bUnit[]       @relation("UnitBillToSalesArea")
  payerUnits        B2bUnit[]       @relation("UnitPayerSalesArea")
  shipToAssignments B2bUnitShipTo[] @relation("ShipToSalesArea")
  soldToConditions  PriceCondition[] @relation("PriceConditionSoldToSalesArea")

  @@id([customerNumber, salesOrganization, distributionChannel, division])
  @@index([salesOrganization, distributionChannel, division], map: "customer_sales_areas_sales_area_idx")
  @@map("customer_sales_areas")
}

// Customer account membership. A customer account is represented by its
// owner, an existing customer. The owner has a row pointing to itself
// (customer = account); members point to the owner. Database rules:
// - primary key: a customer belongs to at most one account, so an owner
//   cannot be a member of another account
// - owner foreign key: an account must be an owner row, so members cannot
//   own accounts (no nesting, no cycles)
// accountOwnerRef is a copy of accountCustomerNumber, because Prisma cannot
// use the same column twice in one foreign key. A CHECK constraint in the
// migration keeps both equal.
model CustomerAccountMember {
  customerNumber        String @id @map("customer_number") @db.VarChar(20)
  accountCustomerNumber String @map("account_customer_number") @db.VarChar(20)
  accountOwnerRef       String @map("account_owner_ref") @db.VarChar(20)

  customer Customer              @relation(fields: [customerNumber], references: [customerNumber], onDelete: Restrict, onUpdate: Restrict)
  owner    CustomerAccountMember @relation("AccountOwner", fields: [accountCustomerNumber, accountOwnerRef], references: [customerNumber, accountCustomerNumber], onDelete: Restrict, onUpdate: Restrict)

  ownedMembers      CustomerAccountMember[] @relation("AccountOwner")
  soldToUnits       B2bUnit[]               @relation("UnitSoldTo")
  billToUnits       B2bUnit[]               @relation("UnitBillTo")
  payerUnits        B2bUnit[]               @relation("UnitPayer")
  shipToAssignments B2bUnitShipTo[]

  @@unique([customerNumber, accountCustomerNumber])
  @@index([accountCustomerNumber])
  @@map("customer_account_members")
}

// A selectable ordering context of a customer account (future webshop).
// Partner foreign keys point to (customer, account) pairs in
// customer_account_members, so every partner belongs to the unit's account.
model B2bUnit {
  unitId                String  @id @map("unit_id") @db.VarChar(20)
  name                  String  @db.VarChar(100)
  accountCustomerNumber String  @map("account_customer_number") @db.VarChar(20)
  soldToCustomerNumber  String  @map("sold_to_customer_number") @db.VarChar(20)
  billToCustomerNumber  String  @map("bill_to_customer_number") @db.VarChar(20)
  payerCustomerNumber   String  @map("payer_customer_number") @db.VarChar(20)
  isActive              Boolean @default(true) @map("is_active")
  // The sales area the unit orders in; fixed after creation
  salesOrganization     String  @map("sales_organization") @db.Char(4)
  distributionChannel   String  @map("distribution_channel") @db.Char(2)
  division              String  @db.Char(2)

  soldTo CustomerAccountMember @relation("UnitSoldTo", fields: [soldToCustomerNumber, accountCustomerNumber], references: [customerNumber, accountCustomerNumber], onDelete: Restrict, onUpdate: Restrict)
  billTo CustomerAccountMember @relation("UnitBillTo", fields: [billToCustomerNumber, accountCustomerNumber], references: [customerNumber, accountCustomerNumber], onDelete: Restrict, onUpdate: Restrict)
  payer  CustomerAccountMember @relation("UnitPayer", fields: [payerCustomerNumber, accountCustomerNumber], references: [customerNumber, accountCustomerNumber], onDelete: Restrict, onUpdate: Restrict)

  // Every partner must be assigned to the unit's sales area
  salesArea       SalesArea         @relation(fields: [salesOrganization, distributionChannel, division], references: [salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict)
  soldToSalesArea CustomerSalesArea @relation("UnitSoldToSalesArea", fields: [soldToCustomerNumber, salesOrganization, distributionChannel, division], references: [customerNumber, salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict, map: "b2b_units_sold_to_sales_area_fkey")
  billToSalesArea CustomerSalesArea @relation("UnitBillToSalesArea", fields: [billToCustomerNumber, salesOrganization, distributionChannel, division], references: [customerNumber, salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict, map: "b2b_units_bill_to_sales_area_fkey")
  payerSalesArea  CustomerSalesArea @relation("UnitPayerSalesArea", fields: [payerCustomerNumber, salesOrganization, distributionChannel, division], references: [customerNumber, salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict, map: "b2b_units_payer_sales_area_fkey")

  shipTos                    B2bUnitShipTo[]  @relation("ShipToUnit")
  shipTosInSalesArea         B2bUnitShipTo[]  @relation("ShipToUnitSalesArea")
  priceConditions            PriceCondition[] @relation("PriceConditionUnit")
  priceConditionsInSalesArea PriceCondition[] @relation("PriceConditionUnitSalesArea")

  @@unique([unitId, accountCustomerNumber])
  // Target of the ship-to foreign key that repeats the sales area
  @@unique([unitId, salesOrganization, distributionChannel, division], map: "b2b_units_unit_id_sales_area_key")
  @@index([accountCustomerNumber])
  @@index([soldToCustomerNumber, accountCustomerNumber])
  @@index([billToCustomerNumber, accountCustomerNumber])
  @@index([payerCustomerNumber, accountCustomerNumber])
  @@index([salesOrganization, distributionChannel, division], map: "b2b_units_sales_area_idx")
  @@index([soldToCustomerNumber, salesOrganization, distributionChannel, division], map: "b2b_units_sold_to_sales_area_idx")
  @@index([billToCustomerNumber, salesOrganization, distributionChannel, division], map: "b2b_units_bill_to_sales_area_idx")
  @@index([payerCustomerNumber, salesOrganization, distributionChannel, division], map: "b2b_units_payer_sales_area_idx")
  @@map("b2b_units")
}

// Allowed ship-to partners of a B2B unit. Account and sales area are
// repeated here so the database can check that the ship-to belongs to the
// unit's account and is assigned to the unit's sales area.
model B2bUnitShipTo {
  unitId                String  @map("unit_id") @db.VarChar(20)
  customerNumber        String  @map("customer_number") @db.VarChar(20)
  accountCustomerNumber String  @map("account_customer_number") @db.VarChar(20)
  isDefault             Boolean @default(false) @map("is_default")
  salesOrganization     String  @map("sales_organization") @db.Char(4)
  distributionChannel   String  @map("distribution_channel") @db.Char(2)
  division              String  @db.Char(2)

  unit   B2bUnit               @relation("ShipToUnit", fields: [unitId, accountCustomerNumber], references: [unitId, accountCustomerNumber], onDelete: Restrict, onUpdate: Restrict)
  member CustomerAccountMember @relation(fields: [customerNumber, accountCustomerNumber], references: [customerNumber, accountCustomerNumber], onDelete: Restrict, onUpdate: Restrict)

  unitInSalesArea   B2bUnit           @relation("ShipToUnitSalesArea", fields: [unitId, salesOrganization, distributionChannel, division], references: [unitId, salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict, map: "b2b_unit_ship_tos_unit_sales_area_fkey")
  customerSalesArea CustomerSalesArea @relation("ShipToSalesArea", fields: [customerNumber, salesOrganization, distributionChannel, division], references: [customerNumber, salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict, map: "b2b_unit_ship_tos_customer_sales_area_fkey")

  @@id([unitId, customerNumber])
  @@unique([unitId], where: { isDefault: true }, map: "b2b_unit_ship_tos_one_default_key")
  @@index([customerNumber, accountCustomerNumber])
  @@index([customerNumber, salesOrganization, distributionChannel, division], map: "b2b_unit_ship_tos_customer_sales_area_idx")
  @@map("b2b_unit_ship_tos")
}

// Level of a price condition (comparable to the key of an SAP condition
// table). The pricing engine checks the levels in this order: B2B unit,
// Sold-to, then the list price of the sales area.
enum PriceConditionScope {
  B2B_UNIT
  SOLD_TO
  SALES_AREA

  @@map("price_condition_scope")
}

// Kind of a condition type (comparable to the SAP condition class): what a
// condition of this type contributes to a price calculation.
enum ConditionClass {
  PRICE
  DISCOUNT_SURCHARGE
  FREIGHT
  TAX

  @@map("condition_class")
}

// How the value of a condition is applied (comparable to the SAP calculation
// type): QUANTITY = amount per unit (e.g. per piece), FIXED_AMOUNT = an
// amount independent of the quantity (e.g. a freight flat rate),
// PERCENTAGE = a percentage of a base value (e.g. a discount or tax).
enum CalculationType {
  QUANTITY
  FIXED_AMOUNT
  PERCENTAGE

  @@map("calculation_type")
}

// Configuration of a condition type (comparable to SAP KSCHL), e.g. ZP02
// Customer Net Price. Condition records refer to a type; the type itself is
// not tied to a scope such as Sold-to or B2B unit. Read-only for now, but
// code, name, activation and configuration are data, so they can be
// administered later. Which combinations of class and calculation type the
// pricing engine can calculate is decided in the code (currently only
// PRICE with QUANTITY). Whether a type may be used for condition records is
// configuration (allowedForConditionRecords), and so are the scopes a type
// may be used with (ConditionTypeScope).
model ConditionType {
  code            String          @id @db.VarChar(4)
  name            String          @db.VarChar(60)
  conditionClass  ConditionClass  @map("condition_class")
  calculationType CalculationType @map("calculation_type")
  isActive        Boolean         @default(true) @map("is_active")
  // May new condition records (price conditions) use this type? Can change
  // later, e.g. when list prices become condition records of their own
  allowedForConditionRecords Boolean @default(false) @map("allowed_for_condition_records")
  // Display order, e.g. in lists and a future pricing procedure overview
  sortOrder       Int             @map("sort_order")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  priceConditions PriceCondition[]
  allowedScopes   ConditionTypeScope[]

  @@map("condition_types")
}

// Configuration: the scopes a condition type may be used with (comparable to
// the condition tables of the access sequence of an SAP condition type),
// e.g. ZP01 List Price only per sales area, ZP02 and ZP03 only per Sold-to or
// B2B unit. Created by migrations, read-only in the API. Price conditions
// refer to their pair (foreign key), so a record can never use a type with a
// scope that is not configured.
model ConditionTypeScope {
  conditionTypeCode String              @map("condition_type_code") @db.VarChar(4)
  scope             PriceConditionScope

  conditionType   ConditionType    @relation(fields: [conditionTypeCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  priceConditions PriceCondition[]

  @@id([conditionTypeCode, scope])
  @@map("condition_type_scopes")
}

// A material price for a period in one sales area (comparable to an SAP
// condition record) of a condition type, e.g. ZP01 List Price, ZP02 or ZP03.
// The scope decides the key: SALES_AREA (list price, no further key),
// SOLD_TO (soldToCustomerNumber) or B2B_UNIT (unitId).
// Database rules written by hand in the migration, because Prisma cannot
// model them:
// - CHECK: the key column matching the scope is set, the others are null
// - CHECK: amount > 0, validTo is null (open-ended) or on/after validFrom
// - EXCLUDE: active conditions with the same sales area, material and key
//   must not have overlapping validity periods (needs btree_gist)
// Foreign keys below keep every condition inside its market: the Sold-to
// is assigned to the sales area, the unit belongs to it, and the currency
// is the currency of the sales organization.
// Conditions are never deleted; they are deactivated via isActive.
model PriceCondition {
  conditionId          Int                 @id @default(autoincrement()) @map("condition_id")
  materialNumber       String              @map("material_number")
  scope                PriceConditionScope
  soldToCustomerNumber String?             @map("sold_to_customer_number") @db.VarChar(20)
  unitId               String?             @map("unit_id") @db.VarChar(20)
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @db.Char(3)
  // Both dates are inclusive
  validFrom            DateTime            @map("valid_from") @db.Date
  validTo              DateTime?           @map("valid_to") @db.Date
  isActive             Boolean             @default(true) @map("is_active")
  conditionTypeCode    String              @map("condition_type_code") @db.VarChar(4)
  // The sales area the price is valid in; fixed after creation
  salesOrganization    String              @map("sales_organization") @db.Char(4)
  distributionChannel  String              @map("distribution_channel") @db.Char(2)
  division             String              @db.Char(2)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  material Material  @relation(fields: [materialNumber], references: [materialNumber], onDelete: Restrict, onUpdate: Restrict)
  soldTo   Customer? @relation(fields: [soldToCustomerNumber], references: [customerNumber], onDelete: Restrict, onUpdate: Restrict)
  unit     B2bUnit?  @relation("PriceConditionUnit", fields: [unitId], references: [unitId], onDelete: Restrict, onUpdate: Restrict)

  // Market consistency (see above)
  salesArea         SalesArea          @relation(fields: [salesOrganization, distributionChannel, division], references: [salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict, map: "price_conditions_sales_area_fkey")
  soldToSalesArea   CustomerSalesArea? @relation("PriceConditionSoldToSalesArea", fields: [soldToCustomerNumber, salesOrganization, distributionChannel, division], references: [customerNumber, salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict, map: "price_conditions_sold_to_sales_area_fkey")
  unitInSalesArea   B2bUnit?           @relation("PriceConditionUnitSalesArea", fields: [unitId, salesOrganization, distributionChannel, division], references: [unitId, salesOrganization, distributionChannel, division], onDelete: Restrict, onUpdate: Restrict, map: "price_conditions_unit_sales_area_fkey")
  salesOrgCurrency  SalesOrganization  @relation(fields: [salesOrganization, currency], references: [code, currencyCode], onDelete: Restrict, onUpdate: Restrict, map: "price_conditions_currency_fkey")
  // The condition type may be used with this scope (configuration)
  conditionTypeScope ConditionTypeScope @relation(fields: [conditionTypeCode, scope], references: [conditionTypeCode, scope], onDelete: Restrict, onUpdate: Restrict, map: "price_conditions_condition_type_scope_fkey")
  // The overlap rule above deliberately ignores the condition type: there is
  // at most one active price per key and day. Future pricing procedures must
  // combine several condition types at once (list price, discounts, freight,
  // tax), which will need their own rules per type.
  conditionType ConditionType @relation(fields: [conditionTypeCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@index([materialNumber])
  @@index([soldToCustomerNumber])
  @@index([unitId])
  @@index([conditionTypeCode])
  @@index([salesOrganization, distributionChannel, division, materialNumber], map: "price_conditions_sales_area_material_idx")
  @@index([soldToCustomerNumber, salesOrganization, distributionChannel, division], map: "price_conditions_sold_to_sales_area_idx")
  @@index([unitId, salesOrganization, distributionChannel, division], map: "price_conditions_unit_sales_area_idx")
  @@index([salesOrganization, currency], map: "price_conditions_currency_idx")
  @@index([conditionTypeCode, scope], map: "price_conditions_condition_type_scope_idx")
  @@map("price_conditions")
}
