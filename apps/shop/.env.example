# Copy this file to .env.local (ignored by Git). Server-side only: neither
# value has the NEXT_PUBLIC_ prefix, so neither ever reaches the browser.

# The ERP API on this computer (local development only)
ERP_API_URL=http://127.0.0.1:3000

# Service key of the shop for the ERP shop API /shop/v1; the same value as
# SHOP_SERVICE_KEY in the root .env of the ERP API. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It identifies the shop server, not a user, and authorizes no customer data.
SHOP_SERVICE_KEY=
