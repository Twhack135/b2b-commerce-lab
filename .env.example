# Copy this file to .env and set your own password.
# .env is ignored by Git and must never be committed.
POSTGRES_PASSWORD=change-me

# Used by Prisma and the ERP API. Use the same password as above.
DATABASE_URL=postgresql://erp_user:change-me@127.0.0.1:5432/b2b_erp

# Service key of the shop BFF (apps/shop) for the ERP shop API /shop/v1.
# It proves that a request comes from the shop server; it is no user login
# and never authorizes customer data. At least 32 visible characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the same value in apps/shop/.env.local. Empty: /shop/v1 answers 503.
SHOP_SERVICE_KEY=
